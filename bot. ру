def split_text(text: str, max_length: int = 3900) -> list[str]:
    chunks = []
    current = ""
 
    for paragraph in text.split("\n"):
        if len(current) + len(paragraph) + 1 <= max_length:
            current += paragraph + "\n"
        else:
            if current.strip():
                chunks.append(current.strip())
            current = paragraph + "\n"
 
    if current.strip():
        chunks.append(current.strip())
 
    return chunks
 
